# Configuração local do vee-radio. O install.sh copia este ficheiro para .env,
# que é o que se edita (nano ~/vee-radio/.env). O .env não vai para o git.

# Acesso pela internet (Cloudflare Tunnel): 1 cria um link público a cada
# arranque; 0 deixa o comando só no telemóvel (abre http://localhost:8080) e na
# rede local (http://<IP-do-telemóvel>:8080). Também se muda em Configurações
# (⚙), que só aparece no comando aberto no próprio telemóvel.
TUNNEL_ENABLED=1

# Tópico do ntfy (https://ntfy.sh) para onde o start.sh envia o link do túnel
# sempre que arranca. Pode ser só o nome (usa o servidor público ntfy.sh) ou o
# endereço completo de outro servidor: https://ntfy.exemplo.pt/radio
# Vazio: abre a página para partilhar o link à mão.
# Escolhe um nome difícil de adivinhar: no ntfy.sh quem souber o tópico recebe
# o link, e quem tiver o link controla a rádio. No ntfy.sh, sem token, o
# start.sh só aceita tópicos com 16 caracteres ou mais.
NTFY_TOPIC_URL=

# Token de acesso (tk_...), só para tópicos ou servidores com autenticação
NTFY_TOKEN=

# Webhook dos Workflows do Microsoft Teams para onde o start.sh também envia o
# link (com ou sem ntfy). No Teams: Workflows, modelo "Send webhook alerts to a
# chat" (ou "... to a channel"), e copia o endereço que ele dá (https://...).
# Envia para um chat só teu ou um canal privado: quem lá estiver recebe o link,
# e quem tem o link controla a rádio. O endereço é uma credencial, não o partilhes.
TEAMS_WEBHOOK_URL=
